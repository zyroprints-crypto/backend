# ---- App ----
ENV=development
DEBUG=true

# ---- Security ----
SECRET_KEY=change-me-super-secret-access-key
REFRESH_SECRET_KEY=change-me-super-secret-refresh-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Database ----
DATABASE_URL=postgresql+psycopg://zyro:zyro@postgres:5432/zyro_prints

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- S3-compatible storage ----
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=zyro-prints
S3_REGION=ap-south-1
S3_USE_SSL=false

# ---- CORS ----
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
PHONEPE_MERCHANT_ID=

# ---- Notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=
FCM_SERVER_KEY=

# ---- AI ----
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=claude-sonnet-4-6
